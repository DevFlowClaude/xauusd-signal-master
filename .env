# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control - it contains secrets.

# Telegram bot (optional but recommended)
# Get token from @BotFather. chat_id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HMAC secret for signing signals (min 32 chars random)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
XAUUSD_MASTER_SECRET=

# MT5 credentials (for auto-login). Can also log in manually in terminal.
MT5_LOGIN_10K=
MT5_PASS_10K=
MT5_SERVER=
MT5_PATH=

# Optional: MT5 terminal path if not default location
# MT5_PATH=C:\Program Files\FxPro - MetaTrader 5\terminal64.exe
